    "fields": [
        {
            "fieldname": "section_setup",
            "fieldtype": "Section Break",
            "label": "Setup"
        },
        {
            "fieldname": "template",
            "fieldtype": "Link",
            "label": "Template",
            "options": "Payroll Import Template",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "customer",
            "fieldtype": "Link",
            "label": "Customer",
            "options": "Customer",
            "fetch_from": "template.customer",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "project",
            "fieldtype": "Link",
            "label": "Project",
            "options": "Project",
            "fetch_from": "template.project",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "work_location",
            "fieldtype": "Link",
            "label": "Work Location",
            "options": "Work Location",
            "fetch_from": "template.filter_by_work_location",
            "read_only": 1
        },
        {
            "fieldname": "column_break_setup",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "payroll_period_start",
            "fieldtype": "Date",
            "label": "Payroll Period Start",
            "reqd": 1
        },
        {
            "fieldname": "payroll_period_end",
            "fieldtype": "Date",
            "label": "Payroll Period End",
            "reqd": 1
        },
        {
            "fieldname": "posting_date",
            "fieldtype": "Date",
            "label": "Posting Date",
            "reqd": 1,
            "description": "The date that will be used as payroll_date if you later push to Additional Salary in Phase 2"
        },
        {
            "fieldname": "section_file",
            "fieldtype": "Section Break",
            "label": "Source File"
        },
        {
            "fieldname": "source_file",
            "fieldtype": "Attach",
            "label": "Customer File",
            "reqd": 1
        },
        {
            "fieldname": "column_break_file",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "source_file_sheet_used",
            "fieldtype": "Data",
            "label": "Sheet Parsed",
            "read_only": 1
        },
        {
            "fieldname": "source_file_rows_total",
            "fieldtype": "Int",
            "label": "Rows Read From File",
            "read_only": 1
        },
        {
            "fieldname": "section_status",
            "fieldtype": "Section Break",
            "label": "Status"
        },
        {
            "fieldname": "status",
            "fieldtype": "Select",
            "label": "Status",
            "options": "Draft\nParsing\nParsed\nReconciliation Pending\nReconciled\nOutputs Generated\nClosed\nCancelled",
            "default": "Draft",
            "in_list_view": 1,
            "read_only": 1
        },
        {
            "fieldname": "parse_error_log",
            "fieldtype": "Long Text",
            "label": "Parse Error Log",
            "read_only": 1,
            "depends_on": "eval:doc.parse_error_log"
        },
        {
            "fieldname": "section_summary",
            "fieldtype": "Section Break",
            "label": "Reconciliation Summary",
            "depends_on": "eval:['Parsed', 'Reconciliation Pending', 'Reconciled', 'Outputs Generated', 'Closed'].includes(doc.status)"
        },
        {
            "fieldname": "rows_matched",
            "fieldtype": "Int",
            "label": "Matched (in file + in system)",
            "read_only": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "rows_unmatched_in_file",
            "fieldtype": "Int",
            "label": "Unmatched in File",
            "read_only": 1,
            "description": "Rows in the customer file that don't match any employee in your system"
        },
        {
            "fieldname": "rows_unaccounted_in_system",
            "fieldtype": "Int",
            "label": "Unaccounted in System",
            "read_only": 1,
            "description": "Employees in your system assigned to this project/location but missing from the customer file"
        },
        {
            "fieldname": "column_break_summary",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "rows_with_warnings",
            "fieldtype": "Int",
            "label": "Rows with Warnings",
            "read_only": 1
        },
        {
            "fieldname": "rows_with_errors",
            "fieldtype": "Int",
            "label": "Rows with Errors",
            "read_only": 1
        },
        {
            "fieldname": "validation_pass_rate",
            "fieldtype": "Percent",
            "label": "Validation Pass Rate",
            "read_only": 1
        },
        {
            "fieldname": "section_parsed",
            "fieldtype": "Section Break",
            "label": "Parsed Rows",
            "collapsible": 1,
            "collapsible_depends_on": "eval:doc.rows_matched > 50"
        },
        {
            "fieldname": "parsed_rows",
            "fieldtype": "Table",
            "label": "Parsed Rows",
            "options": "Payroll Import Row",
            "read_only": 1
        },
        {
            "fieldname": "section_unmatched",
            "fieldtype": "Section Break",
            "label": "Unmatched Rows in File (must resolve)",
            "depends_on": "eval:doc.rows_unmatched_in_file > 0"
        },
        {
            "fieldname": "unmatched_source_rows",
            "fieldtype": "Table",
            "label": "Unmatched Source Rows",
            "options": "Payroll Unmatched Source Row"
        },
        {
            "fieldname": "section_unaccounted",
            "fieldtype": "Section Break",
            "label": "Unaccounted Employees in System (must categorize)",
            "depends_on": "eval:doc.rows_unaccounted_in_system > 0"
        },
        {
            "fieldname": "unaccounted_employees",
            "fieldtype": "Table",
            "label": "Unaccounted Employees",
            "options": "Payroll Unaccounted Employee"
        },
        {
            "fieldname": "section_outputs",
            "fieldtype": "Section Break",
            "label": "Generated Outputs",
            "depends_on": "eval:['Outputs Generated', 'Closed'].includes(doc.status)"
        },
        {
            "fieldname": "internal_sheet_file",
            "fieldtype": "Attach",
            "label": "Internal Sheet (Excel)",
            "read_only": 1
        },
        {
            "fieldname": "additional_salary_file",
            "fieldtype": "Attach",
            "label": "Additional Salary Import (Excel)",
            "read_only": 1,
            "description": "Upload this file in ERPNext via Data Import → Additional Salary"
        },
        {
            "fieldname": "validation_report_file",
            "fieldtype": "Attach",
            "label": "Validation Report (Excel)",
            "read_only": 1
        },
        {
            "fieldname": "column_break_outputs",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "outputs_generated_at",
            "fieldtype": "Datetime",
            "label": "Outputs Generated At",
            "read_only": 1
        },
        {
            "fieldname": "outputs_generated_by",
            "fieldtype": "Link",
            "label": "Generated By",
            "options": "User",
            "read_only": 1
        },
        {
            "fieldname": "section_audit",
            "fieldtype": "Section Break",
            "label": "Audit",
            "collapsible": 1
        },
        {
            "fieldname": "amended_from",
            "fieldtype": "Link",
            "label": "Amended From",
            "options": "Payroll Import Run",
            "read_only": 1,
            "no_copy": 1,
            "print_hide": 1
        }
